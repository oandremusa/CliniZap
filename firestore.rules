rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Blueprint Validation Helpers (Synchronized with firebase-blueprint.json)
    function isValidUserProfile(data) {
      return isSignedIn()
        && data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPatient(data) {
      return isSignedIn()
        && data.keys().hasAll(['nome', 'telefone', 'userId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['nome', 'telefone', 'userId', 'createdAt', 'updatedAt'])
        && data.nome is string
        && data.nome.size() >= 2
        && data.nome.size() <= 120
        && data.telefone is string
        && data.telefone.size() >= 14
        && data.telefone.size() <= 15
        && data.telefone.matches('^\\([0-9]{2}\\) [0-9]{4,5}-[0-9]{4}$')
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Private Professional Profile (/users/{userId})
    match /users/{userId} {
      allow get: if isSignedIn()
        && isVerified()
        && isValidId(userId)
        && request.auth.uid == userId;

      allow list: if false;

      allow create: if isSignedIn()
        && isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidUserProfile(incoming())
        && isSignedIn()
        && isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: SyncProfile
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
        );

      allow delete: if false;

      // Isolated Patient Subcollection (/users/{userId}/patients/{patientId})
      match /patients/{patientId} {
        allow get: if isSignedIn()
          && isVerified()
          && isValidId(userId)
          && isValidId(patientId)
          && request.auth.uid == userId
          && existing().userId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow list: if isSignedIn()
          && isVerified()
          && isValidId(userId)
          && request.auth.uid == userId
          && existing().userId == request.auth.uid;

        allow create: if isSignedIn()
          && isVerified()
          && isValidId(userId)
          && isValidId(patientId)
          && request.auth.uid == userId
          && isValidPatient(incoming())
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            (exists(/databases/$(database)/documents/users/$(userId))
              && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid)
            || (existsAfter(/databases/$(database)/documents/users/$(userId))
              && getAfter(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid)
          );

        allow update: if isValidPatient(incoming())
          && isSignedIn()
          && isVerified()
          && isValidId(userId)
          && isValidId(patientId)
          && request.auth.uid == userId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action: UpdatePatientDetails
            incoming().diff(existing()).affectedKeys().hasOnly(['nome', 'telefone', 'updatedAt'])
          )
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if isSignedIn()
          && isVerified()
          && isValidId(userId)
          && isValidId(patientId)
          && request.auth.uid == userId
          && existing().userId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }
    }
  }
}
